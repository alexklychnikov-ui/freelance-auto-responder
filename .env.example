# ProxyAPI / OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o-mini

# Модели по ролям пайплайна: пусто = fallback на OPENAI_MODEL
# Рекомендуется: DRAFT/EXPERT/REVISE/ESCALATION=gpt-5.4, LOGIC/ESTIMATE/EVIDENCE/QA=gpt-5.4-mini, SCORE=gpt-5.4-nano
# gpt-5.5 и gpt-5-nano не принимают temperature (работают только благодаря guard-у в openai_compat), gpt-5.4-pro не chat-модель
OPENAI_MODEL_DRAFT=
OPENAI_MODEL_LOGIC=
OPENAI_MODEL_EXPERT=
# REVISE = ручная правка готового отклика из Telegram-бота
OPENAI_MODEL_REVISE=
OPENAI_MODEL_SCORE=
OPENAI_MODEL_EVIDENCE=
# ESCALATION = ревизии внутри цикла при застое; обычные ревизии цикла идут на DRAFT
OPENAI_MODEL_ESCALATION=
OPENAI_MODEL_ESTIMATE=
OPENAI_MODEL_QA=

# Telegram (approve-bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Browser
BROWSER_ADAPTER=external
BROWSERMCP_SERVER=C:/Python/Projects/BrowserMCP/packages/mcp-server/dist/index.js
BROWSER_NAVIGATE_WAIT_SECONDS=2

# Paths
RESPONSE_JOURNAL=C:/Python/Projects/Zerocode2md/ResponseJournal/journal.xlsx
DATABASE_PATH=data/seen_projects.db
SOURCES_CONFIG_PATH=config/sources.yaml
LIGHTRAG_MCP=user-lightrag

LIGHTRAG_MCP=user-lightrag
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=

# Headroom — сжатие контекста (LightRAG → GPT, MCP в Cursor)
# Proxy: deploy/Start-HeadroomProxy.ps1 (Docker, порт 8787)
HEADROOM_PROXY_URL=http://127.0.0.1:8787
HEADROOM_COMPRESS_CONTEXT=true
HEADROOM_CONTEXT_MIN_CHARS=2500

# Kwork auto-login (optional; never commit real values)
KWORK_LOGIN=
KWORK_PASSWORD=
KWORK_AUTO_LOGIN=false
KWORK_STORAGE_STATE=data/kwork_storage.json
KWORK_INBOX_POLL_SECONDS=90
FLRU_STORAGE_STATE=data/flru_storage.json
FLRU_MAX_DAILY_RESPONSES=10
FLRU_INBOX_MIRROR_ENABLED=true
FLRU_INBOX_SEEN_DB=data/flru_inbox_seen.db
FLRU_INBOX_POLL_SECONDS=90

# Behavior
SCAN_INTERVAL_MINUTES=15
MIN_GPT_SCORE=7
BUDGET_CEILING_PRICE_MULTIPLIER=2.0
QUICK_WIN_ENABLED=true
QUICK_WIN_MIN_SCORE=5
QUICK_WIN_MAX_BUDGET_RUB=10000
QUICK_WIN_MAX_OFFERS_COUNT=40
QUICK_WIN_MAX_DELIVERY_DAYS=2
EXPERIENCE_WIN_ENABLED=true
EXPERIENCE_WIN_MIN_BUDGET_RUB=500
EXPERIENCE_WIN_MAX_BUDGET_RUB=1000
EXPERIENCE_WIN_MIN_SCORE=4
MAX_DAILY_RESPONSES=5
REQUIRE_TELEGRAM_APPROVAL=true
SCAN_BOOTSTRAP_SKIP_PIPELINE=true
SCAN_EARLY_EXIT_KNOWN_COUNT=5
PREPARE_ONLY_NO_SUBMIT=true
DEFAULT_OFFER_DAYS=14
# Сходимость цикла ревизий отклика
RESPONSE_MAX_CYCLES=4
RESPONSE_MAX_SECONDS=240.0
RESPONSE_STAGNATION_LIMIT=2
PREPARED_RESPONSES_DIR=data/prepared_responses
PENDING_TIMEOUT_HOURS=24
OPERATOR_TIMEZONE=Asia/Irkutsk
# Required in production: directory with *.md response examples for GPT
RESPONSE_EXAMPLES_DIR=C:/Python/Projects/Zerocode2md/Output/Отклики

# Evidence research (URL/attachment facts before response) — off by default
EVIDENCE_RESEARCH_ENABLED=false
EVIDENCE_MAX_URLS=3
EVIDENCE_TIMEOUT_SECONDS=60.0
# Structural site recon для задач парсинга: robots.txt + sitemap + образцовая карточка
# Лимит доп. запросов на источник; 0 = recon выключен
EVIDENCE_RECON_MAX_PAGES=3

